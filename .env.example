# Nombre visible de la aplicación
VITE_NOMBRE_APLICACION=Ambulancia

# Subcarpeta en la que se publica la web detrás del proxy (ej. /ambulancia/). Vacía = la raíz
VITE_RUTA_BASE=

# URL pública del backend (incluye el prefijo global de la API)
VITE_API_URL=http://localhost:3000/api/v1

# Clave de cliente de Geoapify para las teselas del mapa.
# Es pública por naturaleza: restríngela por dominio en el panel de Geoapify.
VITE_GEOAPIFY_API_KEY=

# Ciudad que se propone al ubicar una dirección escrita (geocodificación en el backend)
VITE_CIUDAD_OPERACION=Cúcuta

# Vista inicial del mapa operativo (Cúcuta, Norte de Santander)
VITE_MAPA_CENTRO_LATITUD=7.8939
VITE_MAPA_CENTRO_LONGITUD=-72.5078
VITE_MAPA_ZOOM=13

# Servidor de tiempo real (WebSocket, proyecto ../webSocket)
VITE_TIEMPO_REAL_URL=http://localhost:3001
# Ruta HTTP de Socket.IO. Vacía = /socket.io. Detrás del proxy: /ambulancia/socket.io
VITE_TIEMPO_REAL_RUTA=
